# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: SERVER ONLY. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=lectureleaf
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
MAX_LECTURE_MINUTES=180

# Transcription + notes (https://console.groq.com/keys). Optional: without it PDFs have frames only.
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# If YouTube blocks downloads (common on cloud servers), provide cookies exported from a logged-in browser and/or a proxy.
# YTDLP_COOKIES_FILE=C:/path/to/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port

MAX_JOB_MINUTES=45
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=2
# VIDEO_MAX_HEIGHT=720
# OCR_BUDGET_S=240
# LOCAL_WHISPER_MODEL=base   # offline transcription model: tiny | base | small | medium
# LOCAL_ASR_MAX_MINUTES=90

# ── Handwritten notes (optional) ─────────────────────────────────────────────────────────────────────────
# Photos of notes are read by Google Gemini when this key is set, which is much better at real handwriting than
# the built-in OCR (the built-in OCR is the fallback). Get a free key here: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# ── Backup AI provider (optional) ────────────────────────────────────────────────────────────────────────
# OpenRouter takes over when Groq is rate limited, unavailable or has no key. It covers notes, quizzes, marking
# and (with a vision model) photos of notes. Get a key here: https://openrouter.ai/keys
# Models ending in ":free" cost nothing but have small daily limits; add credit on openrouter.ai for more.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b:free
# OPENROUTER_VISION_MODEL=google/gemini-2.0-flash-exp:free

# Supabase project (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# service_role key: SERVER ONLY. Never put this in the frontend.
SUPABASE_SERVICE_ROLE_KEY=

STORAGE_BUCKET=lectureleaf
CORS_ORIGINS=http://localhost:5173,http://localhost:8443
MAX_LECTURE_MINUTES=180

# Transcription + notes (https://console.groq.com/keys). Optional: without it PDFs have frames only.
GROQ_API_KEY=
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo
# GROQ_LLM_MODEL=llama-3.3-70b-versatile

# If YouTube blocks downloads (common on cloud servers), provide cookies exported from a logged-in browser and/or a proxy.
# YTDLP_COOKIES_FILE=C:/path/to/cookies.txt
# YTDLP_PROXY=http://user:pass@host:port

MAX_JOB_MINUTES=45
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=2
# VIDEO_MAX_HEIGHT=720
# OCR_BUDGET_S=240
# LOCAL_WHISPER_MODEL=base   # offline transcription model: tiny | base | small | medium
# LOCAL_ASR_MAX_MINUTES=90
